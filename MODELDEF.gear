// The body holsters' drawing (zscript/gear/look.zs). Draw only; nothing in the game's rules reads it.
// Shapes and colours are RSQ TacticalRig's (its MODELDEF.txt:47-62,140-155; rig.zs:2957-2984):
// a gun holster is a wire SPHERE, an item spot a wire DIAMOND, so they are told apart by shape.
//
// One model slot per colour, one sprite frame each:
//   A blue (a gun holster, idle)      B green (a hand inside; also the "now this gun's" flash)
//   C red (that press was refused)    D white (the holster was freed)
//   E magenta (an item spot, idle)
// FLAGS BEFORE THE FrameIndex LINES: each FrameIndex snapshots the flags set so far.
// [GEARFIX 2026-11-13] NO DONTCULLBACKFACES, as TacticalRig's markers (its MODELDEF.txt:5-16, 47-62, 140-155): with it the
// far half of every wire showed through the near half and doubled it, which with the additive style read as neon. The
// actors are translucent now (look.zs), at TacticalRig's alphas.

// RAG_Shell: a gun holster's marker. A wire sphere of radius 1 at Scale 1 (three rings); the
// actor's Scale is the spot's radius in map units. rs_wiresphere.obj is the same file as
// TacticalRig's rtwire.obj; rs_wire_idle / rs_wire_hot are its rtwireid / rtwireht.
Model RAG_Shell
{
	Path "models"
	Model 0 "rs_wiresphere.obj"
	Skin 0 "rs_wire_idle.png"
	Model 1 "rs_wiresphere.obj"
	Skin 1 "rs_wire_hot.png"
	Model 2 "rs_wiresphere.obj"
	Skin 2 "rag_wire_red.png"
	Model 3 "rs_wiresphere.obj"
	Skin 3 "rag_wire_white.png"
	Model 4 "rs_wiresphere.obj"
	Skin 4 "rag_wire_util.png"
	Scale 1.0 1.0 1.0
	FrameIndex RAGS A 0 0
	FrameIndex RAGS B 1 0
	FrameIndex RAGS C 2 0
	FrameIndex RAGS D 3 0
	FrameIndex RAGS E 4 0
}

// RAG_Diamond: an item spot's marker (the grenade spot, the ammo pouch). A wire octahedron, corners
// at radius 1 (rag_wirediamond.obj = TacticalRig's models/rsqtr/rtwoct.obj). Same frames and skins.
Model RAG_Diamond
{
	Path "models"
	Model 0 "rag_wirediamond.obj"
	Skin 0 "rs_wire_idle.png"
	Model 1 "rag_wirediamond.obj"
	Skin 1 "rs_wire_hot.png"
	Model 2 "rag_wirediamond.obj"
	Skin 2 "rag_wire_red.png"
	Model 3 "rag_wirediamond.obj"
	Skin 3 "rag_wire_white.png"
	Model 4 "rag_wirediamond.obj"
	Skin 4 "rag_wire_util.png"
	Scale 1.0 1.0 1.0
	FrameIndex RAGS A 0 0
	FrameIndex RAGS B 1 0
	FrameIndex RAGS C 2 0
	FrameIndex RAGS D 3 0
	FrameIndex RAGS E 4 0
}

// RAG_Light: the ammo light. The small wire sphere TacticalRig uses (its RSQTR_AmmoPip, MODELDEF.txt:5-16).
//   A green (half a magazine or more)   B yellow (low, or empty with reserve)   C red (nothing)
Model RAG_Light
{
	Path "models"
	Model 0 "rs_wiresphere.obj"
	Skin 0 "rs_wire_hot.png"
	Model 1 "rs_wiresphere.obj"
	Skin 1 "rag_wire_yellow.png"
	Model 2 "rs_wiresphere.obj"
	Skin 2 "rag_wire_red.png"
	Scale 1.0 1.0 1.0
	FrameIndex RAGS A 0 0
	FrameIndex RAGS B 1 0
	FrameIndex RAGS C 2 0
}

// RAG_Pouch: the ammo pouch on the belt (TacticalRig's RSQTR_PouchShow, MODELDEF.txt:448-458;
// rag_pouch.md3 / .png = its models/rsqtr/rtpouch.md3 / .png). Map units at Scale 1 (5 x 8 x 10 cm),
// centred, X out from the belt.
Model RAG_Pouch
{
	Path "models"
	Model 0 "rag_pouch.md3"
	Skin 0 "rag_pouch.png"
	Scale 1.0 1.0 1.0
	USEACTORPITCH
	USEACTORROLL
	CORRECTPIXELSTRETCH
	FrameIndex RAGN A 0 0
}

// RAG_Nade: the grenade at the buckle (TacticalRig's RSQTR_NadeShow, MODELDEF.txt:421-430). A carrier
// only: the wire sphere with an invisible skin. The actor swaps in the weapon pack's own grenade mesh
// by path (A_ChangeModel: models/bd/Grenade/nade.md3 from the BD22 VR pack). Frame 2 of that mesh
// (ring and spoon on), its body centred on the actor: Offset = -(28.53, -0.02, -1.28).
Model RAG_Nade
{
	Path "models"
	Model 0 "rs_wiresphere.obj"
	Skin 0 "shared/invisible.png"
	Scale 1.0 1.0 1.0
	Offset -28.53 0.02 1.28
	NoInterpolation
	FrameIndex RAGN A 0 2
}

// RAG_Arc: the ammo arc round a full gun holster's light (TacticalRig's RSQTR_AmmoArc, its MODELDEF.txt:18-45;
// rag_arcNN.obj = its models/rsqtr/rtarcNN.obj, k/12 of a circle of radius 1). A-L green steps 1-12, M-X yellow
// steps 1-12. One block per frame: a block's model is fixed. Turned to the eyes by the actor's angle, pitch and roll.
Model RAG_Arc { Path "models" Model 0 "rag_arc01.obj" Skin 0 "rs_wire_hot.png" Scale 1.0 1.0 1.0 USEACTORPITCH USEACTORROLL FrameIndex RAGA A 0 0 }
Model RAG_Arc { Path "models" Model 0 "rag_arc02.obj" Skin 0 "rs_wire_hot.png" Scale 1.0 1.0 1.0 USEACTORPITCH USEACTORROLL FrameIndex RAGA B 0 0 }
Model RAG_Arc { Path "models" Model 0 "rag_arc03.obj" Skin 0 "rs_wire_hot.png" Scale 1.0 1.0 1.0 USEACTORPITCH USEACTORROLL FrameIndex RAGA C 0 0 }
Model RAG_Arc { Path "models" Model 0 "rag_arc04.obj" Skin 0 "rs_wire_hot.png" Scale 1.0 1.0 1.0 USEACTORPITCH USEACTORROLL FrameIndex RAGA D 0 0 }
Model RAG_Arc { Path "models" Model 0 "rag_arc05.obj" Skin 0 "rs_wire_hot.png" Scale 1.0 1.0 1.0 USEACTORPITCH USEACTORROLL FrameIndex RAGA E 0 0 }
Model RAG_Arc { Path "models" Model 0 "rag_arc06.obj" Skin 0 "rs_wire_hot.png" Scale 1.0 1.0 1.0 USEACTORPITCH USEACTORROLL FrameIndex RAGA F 0 0 }
Model RAG_Arc { Path "models" Model 0 "rag_arc07.obj" Skin 0 "rs_wire_hot.png" Scale 1.0 1.0 1.0 USEACTORPITCH USEACTORROLL FrameIndex RAGA G 0 0 }
Model RAG_Arc { Path "models" Model 0 "rag_arc08.obj" Skin 0 "rs_wire_hot.png" Scale 1.0 1.0 1.0 USEACTORPITCH USEACTORROLL FrameIndex RAGA H 0 0 }
Model RAG_Arc { Path "models" Model 0 "rag_arc09.obj" Skin 0 "rs_wire_hot.png" Scale 1.0 1.0 1.0 USEACTORPITCH USEACTORROLL FrameIndex RAGA I 0 0 }
Model RAG_Arc { Path "models" Model 0 "rag_arc10.obj" Skin 0 "rs_wire_hot.png" Scale 1.0 1.0 1.0 USEACTORPITCH USEACTORROLL FrameIndex RAGA J 0 0 }
Model RAG_Arc { Path "models" Model 0 "rag_arc11.obj" Skin 0 "rs_wire_hot.png" Scale 1.0 1.0 1.0 USEACTORPITCH USEACTORROLL FrameIndex RAGA K 0 0 }
Model RAG_Arc { Path "models" Model 0 "rag_arc12.obj" Skin 0 "rs_wire_hot.png" Scale 1.0 1.0 1.0 USEACTORPITCH USEACTORROLL FrameIndex RAGA L 0 0 }
Model RAG_Arc { Path "models" Model 0 "rag_arc01.obj" Skin 0 "rag_wire_yellow.png" Scale 1.0 1.0 1.0 USEACTORPITCH USEACTORROLL FrameIndex RAGA M 0 0 }
Model RAG_Arc { Path "models" Model 0 "rag_arc02.obj" Skin 0 "rag_wire_yellow.png" Scale 1.0 1.0 1.0 USEACTORPITCH USEACTORROLL FrameIndex RAGA N 0 0 }
Model RAG_Arc { Path "models" Model 0 "rag_arc03.obj" Skin 0 "rag_wire_yellow.png" Scale 1.0 1.0 1.0 USEACTORPITCH USEACTORROLL FrameIndex RAGA O 0 0 }
