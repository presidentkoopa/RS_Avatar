"VertexLitGeneric"
{
//Basic
	"$BaseTexture" 			    "models/arachnit/doom_eternal/characters/doom_slayer_marine_guy/classic/doomslayer_arm_right_set3_s"
	"$BumpMap" 				    "models/arachnit/doom_eternal/characters/doom_slayer_marine_guy/classic/doomslayer_arm_right_set3_n"
	"$PhongExponentTexture"     "models/arachnit/doom_eternal/characters/doom_slayer_marine_guy/classic/doomslayer_arm_right_set3_g"

//Warp
//	"$LightWarpTexture"         "models/arachnit/shared/clothes_wrp2"		//< Change as needed
	"$PhongWarpTexture"         "models/arachnit/shared/phongwarp_metal2" 		//< Change as needed

//Phong
	"$Phong"				    "1"
	"$PhongBoost"               "11" 	//< Change as needed
//	"$PhongExponent"            "15" 	//< $PhongExponent overrides $PhongExponentTexture !!!
	"$PhongFresnelRanges"	    "[0.75 1.0 1.0]"
	"$PhongAlbedoTint"          "1"
	"$PhongDisableHalfLambert"  "1"
	"$NormalmapAlphaPhongMask"  "1"

//Rimlight
	"$Rimlight" 			    "0"

//Transparency
	"$Additive" 			  	"1"

//Other
	"$Model"                    "1"
	"$HalfLambert" 			    "0"
	"$NoDecal" 				    "0"
	"$AmbientOcclusion" 	    "0"
	"$NoCull" 				    "0"
	"$SurfaceProp" 			    "metal"
//	"$BlendTintByBaseAlpha"     "1"
	"$Color2"					"{ 0 0 0 }"	//< RGB colors
	"$CloakPassEnabled" 		"1" 	//< For SFM and TF2
