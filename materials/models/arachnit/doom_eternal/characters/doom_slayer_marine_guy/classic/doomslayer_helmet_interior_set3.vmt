"VertexLitGeneric"
{
//Basic
	"$BaseTexture" 			    "models/arachnit/shared/black"
	"$BumpMap" 				    "models/arachnit/shared/flat_normal"
//	"$PhongExponentTexture"     "models/arachnit/shared/flat_exponent"

//Warp
//	"$LightWarpTexture"         "models/arachnit/shared/clothes_wrp2"		//< Change as needed

//Phong
	"$Phong"				    "1"
	"$PhongBoost"               "0.1" 	//< Change as needed
	"$PhongExponent"            "5" 	//< $PhongExponent overrides $PhongExponentTexture !!!
	"$PhongFresnelRanges"	    "[0.3 1 4]"
	"$PhongAlbedoTint"          "0"
	"$PhongDisableHalfLambert"  "1"
	"$NormalmapAlphaPhongMask"  "1"

//Rimlight
	"$Rimlight" 			    "0"

//Other
	"$Model"                    "1"
	"$HalfLambert" 			    "0"
	"$NoDecal" 				    "0"
	"$AmbientOcclusion" 	    "1"
	"$NoCull" 				    "0"
	"$SurfaceProp" 			    "flesh"
//	"$BlendTintByBaseAlpha"     "1"
//	"$Color2"					"{ 255 255 255 }"	//< RGB colors
	"$CloakPassEnabled" 		"1" 	//< For SFM and TF2
